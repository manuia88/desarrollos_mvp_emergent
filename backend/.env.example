# Backend environment configuration — copy to backend/.env and fill real values
# REAL VALUES MUST NEVER BE COMMITTED. Always use placeholders here.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=desarrollosmx

# JWT secret (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET

# Seed admin (used only on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Emergent universal LLM key (Claude Sonnet 4.5 + GPT + Gemini)
EMERGENT_LLM_KEY=REPLACE_WITH_EMERGENT_LLM_KEY

# Mapbox token (signed up at https://account.mapbox.com/access-tokens/)
MAPBOX_TOKEN=REPLACE_WITH_MAPBOX_PUBLIC_TOKEN

# ─── Neo4j Knowledge Graph (W5.12 Parte 1) ───────────────────────────────────
# Vacios o ausentes → backend arranca igual y KG_AVAILABLE=False (fallback relational).
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_in_prod

# Default WhatsApp deep-link fallback (E.164 without +)
DMX_FALLBACK_WHATSAPP=525500000000

# DMX Studio engine selectors (optional — defaults to stub)
# Set to "fal" or "replicate" once real video keys are configured
STUDIO_VIDEO_ENGINE=stub
# Set to "openai-full" to enable 100 unique image generations per ad batch
STUDIO_ADS_ENGINE=openai-stub

# Future engine keys (uncomment + fill when ready)
# FAL_API_KEY=REPLACE_WITH_FAL_API_KEY
# REPLICATE_API_TOKEN=REPLACE_WITH_REPLICATE_API_TOKEN
# ELEVENLABS_API_KEY=REPLACE_WITH_ELEVENLABS_API_KEY

# ─── IE Engine — Phase A ──────────────────────────────────────────────────────
# Encryption key for stored data-source credentials (Fernet base64 urlsafe 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If unset, derives from JWT_SECRET (NOT recommended for production).
IE_FERNET_KEY=

# API keys (optional — sources fall back to "blocked" status when absent)
IE_NOAA_API_KEY=
IE_INEGI_TOKEN=
IE_BANXICO_TOKEN=
IE_AIRROI_API_KEY=

# W5.20 — External Insights Ingest (12 global sources)
# FRED St. Louis Fed (US housing · Case-Shiller). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
IE_FRED_API_KEY=
# Numbeo Property Index (global 500+ ciudades). Free tier limitado: https://www.numbeo.com/api/
IE_NUMBEO_API_KEY=

# CKAN resource IDs (datos.cdmx.gob.mx)
IE_DATOS_CDMX_BASE_URL=https://datos.cdmx.gob.mx/api/3/action
IE_FGJ_CDMX_RESOURCE_ID=
IE_SACMEX_RESOURCE_ID=
IE_LOCATEL_RESOURCE_ID=

# Keyless public URLs
IE_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
IE_CONAGUA_SMN_URL=https://smn.conagua.gob.mx/tools/GUI/webservices/
IE_GTFS_CDMX_URL=

# WMS/WFS
IE_CENAPRED_WFS_URL=
IE_ATLAS_CDMX_BASE_URL=https://geoinformacionpublica.cdmx.gob.mx

# Manual upload storage (local dev — switch to S3 in prod)
IE_UPLOAD_DIR=/uploads/ie_engine

# H2 — Dubai expansion
IE_REELLY_API_KEY=

# Batch 25 — Image Embeddings Pipeline (set to true to enable real vector search)
IMAGE_EMBEDDINGS_ENABLED=false

# Batch 25 — Resend email alerts (https://resend.com)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY

# Batch 30 — Sparklines precio histórico (false=sintético default, true=db.unit_price_history)
PRICE_HISTORY_REAL_DATA=false

# ─── W4.18.3 — Private Beta Gate ──────────────────────────────────────────
# PRIVATE_BETA_MODE=true → /api/auth/register devuelve 403 code=private_beta
# (signup broker con invite code via /api/auth/signup-broker sigue activo)
PRIVATE_BETA_MODE=true
PRIVATE_BETA_INVITE_EXPIRES_DAYS=90
PRIVATE_BETA_BROKER_PORTAL_URL=/broker-portal

# ─── W4.18.2A.0 — PostHog (cliente only · backend NO consume) ─────────────────
# Documentación de las 2 ENV vars consumidas por /app/frontend/src/lib/posthog.js.
# Configurar en /app/frontend/.env (NO aquí). Backend nunca instancia PostHog.
#   REACT_APP_POSTHOG_API_KEY=phc_xxx
#   REACT_APP_POSTHOG_HOST=https://us.i.posthog.com

# W4.9.6 — Luma AI Gaussian Splatting (optional; missing key → stub mode)
LUMA_API_KEY=
LUMA_API_BASE=https://webapp.lumalabs.ai/api/v3
TOUR3DGS_STORAGE_PATH=/app/backend/storage/3dgs
TOUR3DGS_STORAGE_BUCKET=

# W5.5 Parte 1 — Live Pulse + frequencia configurable
LIVE_PULSE_FREQUENCY=weekly
APIFY_TRENDS_REAL=false
